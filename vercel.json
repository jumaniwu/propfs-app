{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/tim/masuk", "destination": "/share/tim-masuk.html" },
    { "source": "/vendor/daftar/:token", "destination": "/share/vendor-daftar.html" },
    { "source": "/vendor/item/:token", "destination": "/share/vendor-item.html" },
    { "source": "/po/:token", "destination": "/share/po.html" },
    { "source": "/lapor/:token", "destination": "/share/lapor.html" },
    { "source": "/progress/:token", "destination": "/share/progress.html" },
    { "source": "/spk/sign/:token", "destination": "/share/spk-sign.html" },
    { "source": "/opname/isi/:token", "destination": "/share/opname.html" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}

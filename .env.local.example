# ── Boleh sampai ke browser ────────────────────────────────────────────────
# Semua yang berawalan VITE_ DISISIPKAN Vite ke dalam berkas JavaScript yang
# diunduh setiap pengunjung. Isinya publik. Jangan pernah menaruh rahasia di
# sini — kunci Gemini pernah dipasang begini, dipanen orang, dan project-nya
# disuspend Google karena dipakai pihak lain.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
VITE_MIDTRANS_ENV=sandbox

# ── HANYA di server (tanpa awalan VITE_) ───────────────────────────────────
# Dibaca oleh api/ai.ts. Browser tidak pernah melihatnya; ia memanggil /api/ai,
# dan servernyalah yang menyimpan kuncinya. Build akan GAGAL bila kunci
# berbentuk AIza… sampai ikut terbundel — lihat pagarKunciPlugin di
# vite.config.ts.
GEMINI_API_KEY=AIzaSy-kunci-hanya-di-server
